# bitbank API (Private API用。ペーパートレードのみの現段階では未使用でも可)
BITBANK_API_KEY=your_bitbank_api_key
BITBANK_API_SECRET=your_bitbank_api_secret

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# サーバー設定
PORT=4000
TARGET_PAIR=btc_jpy

# AIコスト管理
# モデル(claude-haiku-4-5 が低コスト、claude-sonnet-5 は高精度・高コスト)
AI_MODEL=claude-haiku-4-5
AI_MAX_TOKENS=512
# ループが状態をチェックする間隔(ms)。Claude実呼び出しの間隔ではない
AI_POLL_INTERVAL_MS=15000
# Claude実呼び出しの最短間隔(ms)
AI_MIN_CALL_INTERVAL_MS=180000
# 値動きが無くてもこの間隔(ms)で強制的に1回呼ぶ
AI_MAX_CALL_INTERVAL_MS=900000
# 前回判断時からこの%以上値動きしたら最短間隔を待たず早めに呼ぶ
AI_PRICE_CHANGE_THRESHOLD_PCT=0.15
# 1日の推定コスト(JPY)がこれを超えたらその日はAI呼び出しを停止する
AI_DAILY_BUDGET_JPY=100
# 円換算用の概算レート(見積もり用。実際のレートとは異なる場合がある)
AI_USD_JPY_RATE=155

# リスク管理(ペーパートレード)
# 1ポジションあたりの上限金額(円)。この金額をもとに購入数量を自動算出する
AI_MAX_POSITION_JPY=30000
# 同時に保有できる未決済ポジション数の上限
AI_MAX_OPEN_POSITIONS=3
# この含み損率(%)に達したらAIの判断を待たず自動的に成行決済する
AI_STOP_LOSS_PCT=3
