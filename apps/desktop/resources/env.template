# Noctas デスクトップ版の設定ファイル。
# このファイルは初回起動時にだけ作られ、アップデートで上書きされることはありません。
# 編集後はNoctasを再起動してください。
#
# DATABASE_URL をここに書いても無視されます。
# データベースの場所はデスクトップアプリが管理します(このファイルと同じフォルダの noctas.db)。

# Anthropic Claude APIキー。AI売買判断・AI戦略生成に必要。
# 未設定でもNoctasは起動しますが、AI機能は使えません。
#ANTHROPIC_API_KEY=

# 取引対象ペア(カンマ区切り)。先頭がメインペア。既定: btc_jpy
#TARGET_PAIRS=btc_jpy,eth_jpy

# 売買判断用モデル。既定: claude-haiku-4-5(高頻度呼び出しのため低コストモデル)
#AI_MODEL=claude-haiku-4-5

# 戦略生成用モデル。既定: claude-opus-4-8(単発・高品質重視)
#AI_STRATEGY_MODEL=claude-opus-4-8

# 1日の推定コスト(JPY)がこれを超えたら、その日はAI呼び出しを自動停止する。既定: 100
#AI_DAILY_BUDGET_JPY=100

# --- リスク管理(ペーパートレード) ---
# 1ポジションあたりの上限金額(円)。この金額をもとに購入数量を自動算出する。既定: 30000
#AI_MAX_POSITION_JPY=30000

# 同時に保有できる未決済ポジション数の上限。既定: 3
#AI_MAX_OPEN_POSITIONS=3

# この含み損率(%)に達したらAIの判断を待たず自動的に成行決済する。既定: 3
#AI_STOP_LOSS_PCT=3

# この含み益率(%)に達したら自動的に成行決済する。既定: 5
#AI_TAKE_PROFIT_PCT=5

# --- 手数料・スリッページ(ペーパートレードに反映) ---
# 取引手数料(%)。bitbank現物のtaker手数料相当。既定: 0.12
#TRADE_FEE_PCT=0.12

# 成行想定のスリッページ(%)。買いは高く・売りは安く約定させる。既定: 0.02
#TRADE_SLIPPAGE_PCT=0.02
